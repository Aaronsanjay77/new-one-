<!DOCTYPE html>
<html lang="ta">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>3 SECOND MEMORY V2</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

body{
  margin:0;
  min-height:100vh;
  font-family:Arial,sans-serif;
  background:
    radial-gradient(circle at 50% 20%,#202040 0%,#0b0b12 45%,#050507 100%);
  color:white;
  display:flex;
  justify-content:center;
  align-items:center;
  overflow:hidden;
}

.app{
  width:100%;
  max-width:520px;
  min-height:100vh;
  padding:20px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  text-align:center;
}

.logo{
  font-size:13px;
  letter-spacing:4px;
  opacity:.55;
  margin-bottom:10px;
}

h1{
  font-size:38px;
  margin:0;
  letter-spacing:2px;
}

.subtitle{
  opacity:.65;
  margin:8px 0 25px;
}

.card{
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.12);
  border-radius:28px;
  padding:22px;
  backdrop-filter:blur(18px);
  box-shadow:0 20px 60px rgba(0,0,0,.4);
}

input{
  width:100%;
  padding:15px;
  border:none;
  border-radius:15px;
  outline:none;
  background:rgba(255,255,255,.1);
  color:white;
  text-align:center;
  font-size:16px;
  margin-bottom:12px;
}

button{
  width:100%;
  padding:15px;
  border:0;
  border-radius:15px;
  font-size:17px;
  font-weight:bold;
  cursor:pointer;
  background:white;
  color:#111;
}

button:active{
  transform:scale(.97);
}

.hidden{
  display:none!important;
}

.timer{
  font-size:64px;
  font-weight:800;
  margin:5px;
}

.instruction{
  font-size:18px;
  opacity:.8;
  margin-bottom:15px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-top:15px;
}

.symbol{
  aspect-ratio:1;
  border-radius:18px;
  background:rgba(255,255,255,.09);
  border:1px solid rgba(255,255,255,.1);
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:32px;
  transition:.2s;
}

.symbol:active{
  transform:scale(.9);
}

.progress{
  height:5px;
  background:rgba(255,255,255,.1);
  border-radius:20px;
  overflow:hidden;
  margin-top:18px;
}

.bar{
  height:100%;
  width:100%;
  background:white;
  transform-origin:left;
}

.resultIcon{
  font-size:70px;
}

.resultTitle{
  font-size:30px;
  margin:8px 0;
}

.score{
  font-size:22px;
  opacity:.8;
}

.host{
  position:fixed;
  inset:0;
  background:#08080d;
  z-index:50;
  padding:25px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.host h2{
  margin-top:0;
}

.hostBox{
  background:rgba(255,255,255,.07);
  padding:20px;
  border-radius:20px;
  margin-bottom:12px;
}

.secret{
  position:fixed;
  width:35px;
  height:35px;
  left:0;
  top:0;
  opacity:0;
  z-index:100;
}

.small{
  font-size:13px;
  opacity:.5;
  margin-top:15px;
}
</style>
</head>

<body>

<div class="app">

  <div id="startScreen">
    <div class="logo">AESTHETIC MEMORY CHALLENGE</div>

    <h1>3 SECOND<br>MEMORY</h1>

    <div class="subtitle">
      3 விநாடி பார்த்து நினைவில் வை 🧠
    </div>

    <div class="card">

      <input id="playerName"
             maxlength="20"
             placeholder="உங்கள் பெயர்">

      <button onclick="startGame()">
        START CHALLENGE ⚡
      </button>

      <div class="small">
        கவனமாக பாருங்கள்... ஒரே ஒரு வாய்ப்பு.
      </div>

    </div>
  </div>


  <div id="memoryScreen" class="hidden">

    <div class="logo">REMEMBER THIS</div>

    <div class="timer" id="timer">3</div>

    <div class="instruction">
      இந்த symbols-ஐ நினைவில் வை 👀
    </div>

    <div class="grid" id="memoryGrid"></div>

    <div class="progress">
      <div class="bar" id="memoryBar"></div>
    </div>

  </div>


  <div id="questionScreen" class="hidden">

    <div class="logo">YOUR MEMORY</div>

    <h2 id="questionText">
      ★ எங்கே இருந்தது?
    </h2>

    <div class="grid" id="answerGrid"></div>

    <div class="small">
      சரியான இடத்தை தேர்வு செய்
    </div>

  </div>


  <div id="resultScreen" class="hidden">

    <div class="card">

      <div class="resultIcon" id="resultIcon">🔥</div>

      <div class="resultTitle" id="resultTitle">
        YOU SAW IT!
      </div>

      <div class="score" id="scoreText">
        Score: 100
      </div>

      <br>

      <div id="resultMessage">
        உன் observation semma!
      </div>

      <br>

      <button onclick="finishCustomer()">
        DONE ✓
      </button>

    </div>

  </div>

</div>


<!-- Hidden host trigger -->
<div class="secret"
     ontouchstart="hostHoldStart()"
     ontouchend="hostHoldEnd()"
     onmousedown="hostHoldStart()"
     onmouseup="hostHoldEnd()">
</div>


<!-- HOST PANEL -->

<div id="hostPanel" class="host hidden">

  <h2>🔐 HOST PANEL</h2>

  <div class="hostBox">
    <b>Current Round</b>
    <div id="hostRound">—</div>
  </div>

  <div class="hostBox">
    <b>Correct Position</b>
    <div id="hostAnswer">—</div>
  </div>

  <div class="hostBox">
    <b>Customer</b>
    <div id="hostCustomer">—</div>
  </div>

  <div class="hostBox">
    <b>Result</b>
    <div id="hostResult">Waiting...</div>
  </div>

  <button onclick="nextCustomer()">
    NEXT CUSTOMER →
  </button>

  <br>

  <button onclick="closeHost()">
    CLOSE HOST
  </button>

</div>


<script>

let player="";
let correctIndex=0;
let currentRound=1;
let score=0;
let hostHoldTimer;

const symbols=[
  "◆","●","▲","★",
  "■","☾","✦","⬟",
  "♥","✚","♦","♣"
];

let positions=[];


/* ---------- SOUND ---------- */

const AudioContext =
  window.AudioContext || window.webkitAudioContext;

let audioCtx;

function beep(freq=500,duration=.08,type="sine"){
  try{
    if(!audioCtx) audioCtx=new AudioContext();

    const osc=audioCtx.createOscillator();
    const gain=audioCtx.createGain();

    osc.frequency.value=freq;
    osc.type=type;

    gain.gain.setValueAtTime(.04,audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(
      .001,
      audioCtx.currentTime+duration
    );

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime+duration);
  }catch(e){}
}


/* ---------- VIBRATION ---------- */

function vibrate(pattern){
  if(navigator.vibrate){
    navigator.vibrate(pattern);
  }
}


/* ---------- START ---------- */

function startGame(){

  player=
    document.getElementById("playerName")
    .value.trim() || "Player";

  if(audioCtx){
    audioCtx.resume();
  }

  beep(600,.1);

  score=0;

  show("memoryScreen");
  createMemoryRound();

  updateHost();

}


/* ---------- MEMORY ROUND ---------- */

function createMemoryRound(){

  const grid=
    document.getElementById("memoryGrid");

  grid.innerHTML="";

  const count=
    currentRound < 4 ? 6 :
    currentRound < 7 ? 8 : 10;

  positions=
    Array.from(
      {length:count},
      (_,i)=>i
    );

  positions.sort(
    ()=>Math.random()-.5
  );

  const selected=
    symbols
      .sort(()=>Math.random()-.5)
      .slice(0,count);

  correctIndex=
    Math.floor(Math.random()*count);

  selected.forEach((s,i)=>{

    const d=
      document.createElement("div");

    d.className="symbol";
    d.textContent=s;

    grid.appendChild(d);

  });

  document.getElementById("hostAnswer")
    .textContent=
      correctIndex+1;

  document.getElementById("hostRound")
    .textContent=
      currentRound;

  document.getElementById("hostCustomer")
    .textContent=
      player;

  let time=3;

  const timer=
    document.getElementById("timer");

  timer.textContent=time;

  const bar=
    document.getElementById("memoryBar");

  bar.style.transition="none";
  bar.style.transform="scaleX(1)";

  setTimeout(()=>{
    bar.style.transition="transform 3s linear";
    bar.style.transform="scaleX(0)";
  },50);

  const interval=setInterval(()=>{

    time--;

    timer.textContent=time;

    beep(400+time*100,.06);

    if(time<=0){

      clearInterval(interval);

      setTimeout(
        showQuestion,
        150
      );

    }

  },1000);

}


/* ---------- QUESTION ---------- */

function showQuestion(){

  show("questionScreen");

  const grid=
    document.getElementById("answerGrid");

  grid.innerHTML="";

  const count=
    currentRound < 4 ? 6 :
    currentRound < 7 ? 8 : 10;

  for(let i=0;i<count;i++){

    const d=
      document.createElement("div");

    d.className="symbol";

    d.textContent=i+1;

    d.onclick=()=>{
      chooseAnswer(i);
    };

    grid.appendChild(d);

  }

  beep(700,.12);

}


/* ---------- ANSWER ---------- */

function chooseAnswer(index){

  const correct=
    index===correctIndex;

  if(correct){

    score=
      100+
      Math.max(
        0,
        (10-currentRound)*20
      );

    document.getElementById("resultIcon")
      .textContent="🔥";

    document.getElementById("resultTitle")
      .textContent="YOU SAW IT!";

    document.getElementById("resultMessage")
      .textContent=
      "உன் observation semma! 🧠";

    beep(900,.15);
    beep(1200,.18);

    vibrate([80,60,120]);

    document.getElementById("hostResult")
      .textContent="WIN ✓";

  }else{

    score=0;

    document.getElementById("resultIcon")
      .textContent="👀";

    document.getElementById("resultTitle")
      .textContent="SO CLOSE!";

    document.getElementById("resultMessage")
      .textContent=
      "உன் brain ஒரு step miss பண்ணிடுச்சு 😈";

    beep(180,.25,"sawtooth");

    vibrate([120,80,120]);

    document.getElementById("hostResult")
      .textContent="MISS ✕";

  }

  document.getElementById("scoreText")
    .textContent=
      "Score: "+score;

  show("resultScreen");

}


/* ---------- FINISH ---------- */

function finishCustomer(){

  currentRound++;

  show("startScreen");

  document.getElementById("playerName")
    .value="";

  document.getElementById("hostResult")
    .textContent="Waiting...";

  updateHost();

}


/* ---------- NEXT CUSTOMER ---------- */

function nextCustomer(){

  closeHost();

  currentRound=1;

  show("startScreen");

  document.getElementById("playerName")
    .value="";

}


/* ---------- HOST ---------- */

function hostHoldStart(){

  hostHoldTimer=
    setTimeout(()=>{
      openHost();
    },3000);

}

function hostHoldEnd(){

  clearTimeout(hostHoldTimer);

}

function openHost(){

  document.getElementById("hostPanel")
    .classList.remove("hidden");

  updateHost();

}

function closeHost(){

  document.getElementById("hostPanel")
    .classList.add("hidden");

}

function updateHost(){

  document.getElementById("hostRound")
    .textContent=currentRound;

  document.getElementById("hostAnswer")
    .textContent=
      correctIndex+1;

  document.getElementById("hostCustomer")
    .textContent=
      player || "—";

}


/* ---------- SCREEN ---------- */

function show(id){

  [
    "startScreen",
    "memoryScreen",
    "questionScreen",
    "resultScreen"
  ].forEach(x=>{
    document.getElementById(x)
      .classList.add("hidden");
  });

  document.getElementById(id)
    .classList.remove("hidden");

}

</script>

</body>
</html>
